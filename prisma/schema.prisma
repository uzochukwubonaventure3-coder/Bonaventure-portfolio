generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

/// This model contains row level security and requires additional setup for migrations. Visit https://pris.ly/d/row-level-security for more info.
model Admin {
  id        String   @id @default(dbgenerated("uuid_generate_v4()")) @db.Uuid
  email     String   @unique
  password  String
  name      String
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime @default(now()) @map("updated_at") @db.Timestamptz(6)

  @@map("admins")
}

/// This table contains check constraints and requires additional setup for migrations. Visit https://pris.ly/d/check-constraints for more info.
/// This model contains row level security and requires additional setup for migrations. Visit https://pris.ly/d/row-level-security for more info.
model ai_queue {
  id            String    @id @default(dbgenerated("uuid_generate_v4()")) @db.Uuid
  resource_id   String    @db.Uuid
  resource_type String
  status        String    @default("pending")
  attempts      Int?      @default(0)
  error         String?
  created_at    DateTime  @default(now()) @db.Timestamptz(6)
  processed_at  DateTime? @db.Timestamptz(6)

  @@index([status], map: "aq_status_idx")
}

/// This model contains row level security and requires additional setup for migrations. Visit https://pris.ly/d/row-level-security for more info.
model ContactMessage {
  id        String   @id @default(dbgenerated("uuid_generate_v4()")) @db.Uuid
  name      String
  email     String
  budget    String?
  message   String
  read      Boolean  @default(false)
  replied   Boolean  @default(false)
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  @@map("contact_messages")
}

/// This model contains row level security and requires additional setup for migrations. Visit https://pris.ly/d/row-level-security for more info.
model Experience {
  id        String   @id @default(dbgenerated("uuid_generate_v4()")) @db.Uuid
  title     String
  company   String
  type      String
  period    String
  badge     String?
  initials  String
  color     String   @default("#F97316")
  tags      String[] @default([])
  bullets   String[] @default([])
  order     Int      @default(0)
  current   Boolean  @default(false)
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime @default(now()) @map("updated_at") @db.Timestamptz(6)

  @@index([order])
  @@map("experience")
}

/// This model contains row level security and requires additional setup for migrations. Visit https://pris.ly/d/row-level-security for more info.
model github_activity {
  id            String    @id @default(dbgenerated("uuid_generate_v4()")) @db.Uuid
  event_type    String
  repo_name     String
  repo_url      String?
  branch        String?
  message       String?
  sha           String?
  files_changed Int?      @default(0)
  additions     Int?      @default(0)
  deletions     Int?      @default(0)
  external_id   String?   @unique
  committed_at  DateTime? @db.Timestamptz(6)
  raw_payload   Json?
  created_at    DateTime  @default(now()) @db.Timestamptz(6)

  @@index([committed_at(sort: Desc)], map: "ga_time_idx")
  @@index([event_type], map: "ga_type_idx")
}

/// This table contains check constraints and requires additional setup for migrations. Visit https://pris.ly/d/check-constraints for more info.
/// This model contains row level security and requires additional setup for migrations. Visit https://pris.ly/d/row-level-security for more info.
/// This model contains an expression index which requires additional setup for migrations. Visit https://pris.ly/d/expression-indexes for more info.
model BlogPost {
  id          String   @id @default(dbgenerated("uuid_generate_v4()")) @db.Uuid
  title       String
  slug        String   @unique
  content     String   @default("")
  excerpt     String?
  coverUrl    String?  @map("cover_image")
  coverId     String?  @map("cover_image_id")
  tags        String[] @default([])
  category    String   @map("section")
  platform    String   @default("self")
  externalUrl String?  @map("external_url")
  readTime    Int      @default(1) @map("reading_time")
  aiSummary   String?  @map("ai_summary")
  featured    Boolean  @default(false)
  published   Boolean  @default(false)
  views       Int      @default(0)
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt   DateTime @default(now()) @map("updated_at") @db.Timestamptz(6)

  @@index([createdAt(sort: Desc)])
  @@index([featured])
  @@index([published])
  @@index([category])
  @@index([tags], type: Gin)
  @@map("posts")
}

/// This model contains row level security and requires additional setup for migrations. Visit https://pris.ly/d/row-level-security for more info.
model Project {
  id          String   @id @default(dbgenerated("uuid_generate_v4()")) @db.Uuid
  title       String
  slug        String   @unique
  url         String?
  date        String?
  description String   @default("")
  tags        String[] @default([])
  categories  String[] @default([])
  imageUrl    String?  @map("image_url")
  imageId     String?  @map("image_id")
  liveUrl     String?  @map("live_url")
  githubUrl   String?  @map("github_url")
  featured    Boolean  @default(false)
  published   Boolean  @default(true)
  order       Int      @default(0)
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt   DateTime @default(now()) @map("updated_at") @db.Timestamptz(6)

  @@index([featured])
  @@index([order])
  @@index([published])
  @@map("projects")
}

/// This model contains row level security and requires additional setup for migrations. Visit https://pris.ly/d/row-level-security for more info.
model SiteSettings {
  id        String   @id @default(dbgenerated("uuid_generate_v4()")) @db.Uuid
  key       String   @unique
  value     String   @default("")
  updatedAt DateTime @default(now()) @map("updated_at") @db.Timestamptz(6)

  @@map("site_settings")
}

/// This table contains check constraints and requires additional setup for migrations. Visit https://pris.ly/d/check-constraints for more info.
/// This model contains row level security and requires additional setup for migrations. Visit https://pris.ly/d/row-level-security for more info.
model social_posts {
  id           String    @id @default(dbgenerated("uuid_generate_v4()")) @db.Uuid
  platform     String
  external_id  String
  external_url String?
  content      String    @default("")
  media_urls   String[]  @default([])
  media_ids    String[]  @default([])
  ai_summary   String?
  ai_tags      String[]  @default([])
  ai_category  String?
  ai_seo_desc  String?
  reading_time Int?      @default(1)
  likes        Int?      @default(0)
  reposts      Int?      @default(0)
  replies      Int?      @default(0)
  impressions  Int?      @default(0)
  synced_at    DateTime  @default(now()) @db.Timestamptz(6)
  published_at DateTime? @db.Timestamptz(6)
  raw_payload  Json?
  featured     Boolean?  @default(false)
  hidden       Boolean?  @default(false)
  retry_count  Int?      @default(0)
  last_error   String?

  @@unique([platform, external_id])
  @@index([ai_category], map: "sp_category_idx")
  @@index([platform, external_id], map: "sp_ext_id_idx")
  @@index([platform], map: "sp_platform_idx")
  @@index([published_at(sort: Desc)], map: "sp_published_idx")
  @@index([ai_tags], map: "sp_tags_idx", type: Gin)
}

/// This table contains check constraints and requires additional setup for migrations. Visit https://pris.ly/d/check-constraints for more info.
/// This model contains row level security and requires additional setup for migrations. Visit https://pris.ly/d/row-level-security for more info.
model TechSkill {
  id        String   @id @default(dbgenerated("uuid_generate_v4()")) @db.Uuid
  name      String
  icon      String   @default("")
  category  String
  order     Int      @default(0)
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  @@index([category])
  @@index([order])
  @@map("tech_skills")
}

/// This model contains row level security and requires additional setup for migrations. Visit https://pris.ly/d/row-level-security for more info.
model Testimonial {
  id        String   @id @default(dbgenerated("uuid_generate_v4()")) @db.Uuid
  quote     String
  name      String
  title     String
  avatarUrl String?  @map("avatar_url")
  avatarId  String?  @map("avatar_id")
  initials  String
  featured  Boolean  @default(true)
  approved  Boolean  @default(false)
  order     Int      @default(999)
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime @default(now()) @map("updated_at") @db.Timestamptz(6)

  @@map("testimonials")
}

/// This table contains check constraints and requires additional setup for migrations. Visit https://pris.ly/d/check-constraints for more info.
/// This model contains row level security and requires additional setup for migrations. Visit https://pris.ly/d/row-level-security for more info.
model webhook_logs {
  id         String   @id @default(dbgenerated("uuid_generate_v4()")) @db.Uuid
  platform   String
  event_id   String?
  status     String
  payload    Json?
  error      String?
  attempts   Int?     @default(1)
  created_at DateTime @default(now()) @db.Timestamptz(6)

  @@index([platform], map: "wl_platform_idx")
  @@index([status], map: "wl_status_idx")
  @@index([created_at(sort: Desc)], map: "wl_time_idx")
}
